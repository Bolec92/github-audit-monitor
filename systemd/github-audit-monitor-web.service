[Unit]
Description=GitHub Audit Monitor web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghamaudit
Group=ghamaudit
WorkingDirectory=/opt/github-audit-monitor/app
EnvironmentFile=/etc/github-audit-monitor/config.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/sh -c 'exec /opt/github-audit-monitor/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 120 --bind "${BIND_ADDRESS:-0.0.0.0}:${PORT:-8080}" app:app'
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/github-audit-monitor /var/backups/github-audit-monitor

[Install]
WantedBy=multi-user.target
