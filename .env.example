# GitHub connection is configured after login in Settings -> GitHub connection.
# New installations should leave these empty. GITHUB_ORG/GITHUB_TOKEN are read
# only as a one-way migration path for older v0.7.x installations.
GITHUB_ORG=
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10

# Defaults only; snapshot schedule/timezone are configurable in the authenticated panel.
TZ=Europe/Warsaw
SNAPSHOT_ENABLED=true
SNAPSHOT_HOUR=3
SNAPSHOT_MINUTE=0
RUN_ON_START=false
BIND_ADDRESS=0.0.0.0
PORT=8080

DATABASE_PATH=/data/github-audit.db
BACKUP_DIR=/backups
BACKUP_KEEP=30
SECURITY_DB_PATH=/data/security.db
MASTER_KEY_PATH=/data/security.key

# HTTP/LAN mode. Set true only after the panel is served through HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_MINUTES=15
SETUP_CODE_TTL_HOURS=24
PASSWORD_MIN_LENGTH=14

# Legacy/default fallback only. New installs configure this in Settings.
EMAIL_DOMAIN_REWRITE_FROM=
EMAIL_DOMAIN_REWRITE_TO=
APP_UID=1000
APP_GID=1000
